#!/bin/sh
set -eu

if [ -n "$(printenv RASPA3_EXECUTABLE 2>/dev/null)" ]; then
  raspa3_executable=$RASPA3_EXECUTABLE
elif command -v raspa3 >/dev/null 2>&1; then
  raspa3_executable=$(command -v raspa3)
else
  raspa3_executable="@PACKAGE_INSTALL_PREFIX@/bin/raspa3"
fi

if [ ! -x "$raspa3_executable" ]; then
  echo "RASPA3 executable not found: $raspa3_executable" >&2
  echo "Add the installed bin directory to PATH or set RASPA3_EXECUTABLE." >&2
  exit 127
fi

# An installation made with cmake --install --prefix may have moved since configure.
if [ -z "${RASPA_DIR:-}" ]; then
  executable_prefix=$(CDPATH= cd -- "$(dirname -- "$raspa3_executable")/.." && pwd)
  if [ -d "$executable_prefix/share/raspa3/forcefields" ]; then
    RASPA_DIR=$executable_prefix
  else
    RASPA_DIR="@PACKAGE_INSTALL_PREFIX@"
  fi
  export RASPA_DIR
fi

exec "$raspa3_executable" "$@"
